# Port aplikasi web
PORT=3000

# Host server (gunakan localhost untuk lokal, atau 0.0.0.0 agar bisa diakses via LAN/WiFi sesama tim)
HOST=localhost

# URL koneksi PostgreSQL: postgres://<user>:<password>@<host>:<port>/<nama_database>
DATABASE_URL=postgres://postgres:password@localhost:5432/marketplace_gunadarma

# Secret key untuk enkripsi cookie session
SESSION_SECRET=ganti_dengan_random_secret_string_minimal_32_karakter

# Environment (development / production)
NODE_ENV=development
